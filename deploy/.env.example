# Configuracion del deploy. Copialo a .env y completalo:
#
#   cp .env.example .env
#
# El .env queda SOLO en el server y nunca se commitea (esta en .gitignore).

# --- Obligatorios ---

# El dominio (o subdominio) que apunta al VPS. Caddy consigue el certificado HTTPS solo.
# Ejemplo: bondi.tudominio.com
DOMINIO=

# Contrasena de la base (la crea el propio compose; inventa una larga).
POSTGRES_PASSWORD=

# Credenciales de la API de la Intendencia (api.montevideo.gub.uy, ver README principal).
MONTEVIDEO_CLIENT_ID=
MONTEVIDEO_CLIENT_SECRET=

# --- Opcionales: vacios = esa pata queda apagada ---

# Bot de Telegram (@BotFather). Con el token alcanza: long polling, sin webhook.
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (developers.facebook.com). El webhook queda en
# https://TU-DOMINIO/webhook/whatsapp con este verify token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Solo si queres el bot de Telegram en modo lenguaje natural (paga por mensaje; ojo publico).
ANTHROPIC_API_KEY=
